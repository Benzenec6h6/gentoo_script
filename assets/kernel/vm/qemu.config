CONFIG_PRINTK=y
CONFIG_EARLY_PRINTK=y

CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_CORE=y
CONFIG_SERIAL_CORE_CONSOLE=y

CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y

CONFIG_HPET=n
CONFIG_HPET_TIMER=n

CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y

CONFIG_UNIX=y
CONFIG_SYSFS=y
CONFIG_PROC_FS=y
CONFIG_SIGNALFD=y
CONFIG_EPOLL=y

CONFIG_NET=y
CONFIG_INET=y
CONFIG_PACKET=y
CONFIG_UNIX_DIAG=y

CONFIG_EXT4_FS=y
CONFIG_FS_MBCACHE=y
CONFIG_JBD2=y
CONFIG_CRC16=y
CONFIG_BLK_DEV_INITRD=y

# --- ディスプレイ表示に必須 ---
CONFIG_DRM=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# --- UEFI環境での表示に必須 ---
CONFIG_SYSFB=y
CONFIG_FB_EFI=y
CONFIG_DRM_SIMPLEDRM=y

# --- EFI / UEFI ---
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_MIXED=n
CONFIG_EFI_VARS=y

# --- 入力デバイス（キーボード等） ---
CONFIG_INPUT=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_VIRTIO_INPUT=y

CONFIG_VT=y
CONFIG_VT_CONSOLE=y

# 仮想マシンの共有フォルダ等を使う場合に便利
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_9P_FS=y
CONFIG_9P_FS_POSIX_ACL=y

# パフォーマンス最適化（VM用）
CONFIG_PARAVIRT=y
CONFIG_PARAVIRT_SPINLOCKS=y
CONFIG_PARAVIRT_CLOCK=y

# KVM準仮想化（必須）
CONFIG_KVM_GUEST=y
CONFIG_HYPERVISOR_GUEST=y

# clocksource関連
CONFIG_KVM_CLOCK=y

# その他VM安定性向上
CONFIG_VIRTIO_BALLOON=y
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_MEMORY_BALLOON=y

# PCIホットプラグ（QEMUでのデバイス追加に必要）
CONFIG_HOTPLUG_PCI=y
CONFIG_HOTPLUG_PCI_PCIE=y
